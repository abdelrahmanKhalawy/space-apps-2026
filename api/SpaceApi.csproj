<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mock data ships with the app so the deployed server can seed itself. -->
    <Content Include="..\data\mock\day143.json" Link="SeedData\day143.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\data\mock\day143.json')" />
    <!-- Color rules (research/thresholds.json) ship with the app too. -->
    <Content Include="..\research\thresholds.json" Link="SeedData\thresholds.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Precomputed anomaly explanations (i3): the demo-safe fallback for GET /api/explain. -->
    <Content Include="..\data\precomputed\explain.json" Link="SeedData\explain.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\data\precomputed\explain.json')" />
    <!-- Space-hazard explanation text (n2): what live GET /api/explain actually reads from. -->
    <Content Include="..\research\explanations.json" Link="SeedData\explanations.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\research\explanations.json')" />
    <!-- Precomputed trend forecast (i4): the demo-safe fallback for POST /forecast. -->
    <Content Include="..\data\precomputed\forecast.json" Link="SeedData\forecast.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\data\precomputed\forecast.json')" />
    <!-- A real NOAA space-weather reading: the fallback for GET /api/space-weather when NOAA is unreachable. -->
    <Content Include="..\data\precomputed\space-weather.json" Link="SeedData\space-weather.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\data\precomputed\space-weather.json')" />
  </ItemGroup>

</Project>
